# pnpm keeps node_modules strict by default: a package you did not declare is
# not importable. Kept on, so the dependency list stays honest.

# ESLint and Prettier resolve their plugins from the project root rather than
# from the config that declares them, so those have to be hoisted.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*

# Fail instead of silently installing a different version than `packageManager`.
engine-strict=true
